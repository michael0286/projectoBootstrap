{
  "name": "bootstrapcurso",
  "version": "1.0.0",
  "description": "proyecto boostrap",
  "main": "index.html",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "lite-server",
    "start": "concurrently \"npm run watch:scss\" \"npm run dev \" ",
    "scss": "sass --watch scss:css",
    "watch:scss": "onchange 'scss/*.scss' -- npm run scss ",
    "clean": "rimraf dist",
    "imagemin": "imagemin img/* --out-dir dist/img",
    "usemin": "usemin index.html -d dist/ --htmlmin -o dist/index.html & usemin about.html -d dist/ --htmlmin -o dist/about.html && usemin contacto.html -d dist/ --htmlmin -o dist/contacto.html && usemin precios.html -d dist/ --htmlmin -o dist/precios.html",
    "build": "npm run clean && npm run scss && npm run imagemin & npm run usemin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michael0286/projectoBootstrap.git"
  },
  "author": "m",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/michael0286/projectoBootstrap/issues"
  },
  "homepage": "https://github.com/michael0286/projectoBootstrap#readme",
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "cssmin": "^0.4.3",
    "htmlmin": "^0.0.7",
    "less": "^4.9.1",
    "lite-server": "^2.6.1",
    "onchange": "^7.1.0",
    "rimraf": "^6.1.3",
    "sass": "^1.105.2",
    "uglifyjs": "^2.4.11",
    "usemin-cli": "^0.6.0"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "concurrently": "^10.0.6",
    "jquery": "^4.0.0",
    "popper.js": "^1.16.1"
  }
}
